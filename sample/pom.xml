<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- Sample CLI apps only — not in the reactor modules list. Do not reintroduce kernel-bom. -->
	<parent>
		<groupId>io.mosip.imagedecoder</groupId>
		<artifactId>imagedecoder-parent</artifactId>
		<version>0.10.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>sample-imagedecoder</artifactId>
	<version>0.10.1-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>sample-imagedecoder</name>
	<url>https://github.com/mosip/imagedecoder</url>
	<description>
		Standalone CLI demo for imagedecoder: batch-decode JPEG2000 (.jp2) or WSQ (.wsq) files
		from a folder (BiometricInfo). Not published to Maven Central. Use
		run-jp2000-decoder / run-wsq-decoder scripts after packaging this module.
		Library local runner lives under imagedecoder/run-local.(bat|sh).
	</description>

	<dependencies>
		<!--
			imagedecoder: Library under demo — OpenJpegDecoder / WsqDecoder.
			Version from parent (${mosip.imagedecoder.version}). MPL-2.0.
		-->
		<dependency>
			<groupId>io.mosip.imagedecoder</groupId>
			<artifactId>imagedecoder</artifactId>
		</dependency>
		<!--
			kernel-core: Logger SPI / Logfactory used by sample CLI.
			${kernel.core.version}. MPL-2.0. Exclude security starter (library CLI).
		-->
		<dependency>
			<groupId>io.mosip.kernel</groupId>
			<artifactId>kernel-core</artifactId>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-security</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!--
			slf4j bridges: Route JUL / JCL to SLF4J for console sample runs.
			Versions from Boot parent. License: MIT.
		-->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>jul-to-slf4j</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>jcl-over-slf4j</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>${maven.jar.plugin.version}</version>
				<configuration>
					<archive>
						<manifest>
							<addClasspath>true</addClasspath>
							<mainClass>io.mosip.imagedecoder.sample.SampleImageDecoderApplication</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>${maven.dependency.plugin.version}</version>
				<executions>
					<execution>
						<id>copy</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/lib</outputDirectory>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>false</overWriteSnapshots>
							<overWriteIfNewer>true</overWriteIfNewer>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<version>${maven.resources.plugin.version}</version>
				<executions>
					<execution>
						<id>copy-biometric-info</id>
						<phase>validate</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${basedir}/target/BiometricInfo</outputDirectory>
							<resources>
								<resource>
									<directory>${basedir}/BiometricInfo</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-run-scripts</id>
						<phase>validate</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${basedir}/target</outputDirectory>
							<resources>
								<resource>
									<directory>${basedir}</directory>
									<filtering>true</filtering>
									<includes>
										<include>run-jp2000-decoder.bat</include>
										<include>run-jp2000-decoder.sh</include>
										<include>run-wsq-decoder.bat</include>
										<include>run-wsq-decoder.sh</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
