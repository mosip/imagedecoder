<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.mosip.imagedecoder</groupId>
		<artifactId>imagedecoder-parent</artifactId>
		<version>0.10.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>imagedecoder</artifactId>
	<packaging>jar</packaging>

	<name>Imagedecoder</name>
	<url>https://github.com/mosip/imagedecoder</url>
	<description>
		Pure-Java biometric image decoder for MOSIP: JPEG2000 (ported from OpenJPEG / openjp2)
		and WSQ (ported from NBIS). Entry point IImageDecoderApi.decode(DecoderRequestInfo) returns
		metadata (width, height, DPI, color space, bit rate, compression ratio, lossless) plus
		base64url pixel data and optional BufferedImage. No native codec libraries required.
		Depends on kernel-core only (version from parent kernel.core.version) (Logfactory lives in kernel-core — do not add
		kernel-bom or kernel-logger-logback). Jackson 2 via spring-boot-jackson2 under Boot 4.1.1.
	</description>

	<!-- Inherits version properties and plugins from imagedecoder-parent. Do not reintroduce kernel-bom. -->
	<properties>
		<sonar.coverage.exclusions>
			**/config/**,**/dto/**,**/entity/**
		</sonar.coverage.exclusions>
	</properties>

	<dependencies>
		<!--
			kernel-core: MOSIP exceptions, Logger SPI, and Logfactory (io.mosip.kernel.logger.logback).
			Version from parent dependencyManagement (${kernel.core.version}). MPL-2.0.
			Exclude spring-boot-starter-security — this is a library, not a secured web app.
		-->
		<dependency>
			<groupId>io.mosip.kernel</groupId>
			<artifactId>kernel-core</artifactId>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-security</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!--
			slf4j-api: Logging API used via kernel-core Logfactory / bridges.
			Version from Boot parent. License: MIT.
		-->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<!--
			jul-to-slf4j / jcl-over-slf4j: Route JUL and Commons Logging to SLF4J.
			Versions from Boot parent. License: MIT.
		-->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>jul-to-slf4j</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>jcl-over-slf4j</artifactId>
		</dependency>
		<!--
			spring-boot-jackson2: Boot 4 defaults to Jackson 3; keep Jackson 2 for MOSIP payloads.
			Version from Boot parent.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-jackson2</artifactId>
		</dependency>
		<!--
			jackson-databind / jackson-core: JSON helpers if consumers serialize decoder models.
			Versions from Boot (via jackson2). License: Apache-2.0.
		-->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-core</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Fat JAR for convenience; primary artifact remains the thin library JAR. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>${maven.assembly.plugin.version}</version>
				<configuration>
					<descriptorRefs>
						<descriptorRef>jar-with-dependencies</descriptorRef>
					</descriptorRefs>
				</configuration>
				<executions>
					<execution>
						<id>make-assembly</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
